{
  "name": "carlos-office-back",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "dev": "nodemon --watch server.mjs --watch src --watch package.json --watch .env --ext mjs,json,env --delay 250ms --signal SIGTERM --exec \"node --env-file=.env server.mjs\"",
    "mcp": "node --env-file=.env src/mcp/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "nodemon": "^3.1.14",
    "zod": "^4.0.0"
  }
}
