LOCAL_HOST=127.0.0.1
LOCAL_PORT=3002
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Ollama cloud primary with a local-only fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=minimax-m3:cloud
OLLAMA_FALLBACK_MODEL=qwen3:8b

# Permanent Markdown memory and all Carlos Office application state.
# Defaults to ~/CarlosOfficeVault when empty. Open this folder directly in Obsidian.
OBSIDIAN_VAULT_PATH=
MEMORY_TIME_ZONE=America/Guayaquil

# Optional cloud providers
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional web-search providers. If none are configured, DuckDuckGo HTML is used.
SEARCH_PROVIDER=auto
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
