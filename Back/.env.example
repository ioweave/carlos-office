LOCAL_HOST=127.0.0.1
LOCAL_PORT=3002
# Permit any HTTP/HTTPS localhost or 127.0.0.1 frontend port while the backend is loopback-bound.
ALLOW_LOOPBACK_ORIGINS=true
# Explicit additional origins remain supported. Required when binding the backend beyond loopback.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Local API payload and attachment limits.
MAX_CHAT_BODY_BYTES=30000000
MAX_ATTACHMENT_BYTES=8388608
MAX_ATTACHMENTS_TOTAL_BYTES=20971520
MAX_TEXT_ATTACHMENT_CHARS=200000
# Text/JSON artifact reads remain bounded; binary image/PDF/audio/video artifacts use ranged streaming instead.
ARTIFACT_PREVIEW_MAX_BYTES=12000000
# Maximum individual artifact allowed through the local ranged media stream (default 1 GiB).
ARTIFACT_STREAM_MAX_BYTES=1073741824

# Retention lifecycle.
TEMP_SOURCE_TTL_MS=86400000
# The retention scheduler sweeps expired session sources and verbose job events hourly.
RETENTION_CLEANUP_INTERVAL_MS=3600000
# Remembered facts are compact semantic memory stored in one Markdown-backed record, not one file per fact.
MAX_REMEMBERED_FACTS=2000

# Live Office Map traffic and activity observability.
RUNTIME_EVENT_RETENTION_MS=300000
# Recent per-agent chat/tool activity is RAM-only observability.
RUNTIME_ACTIVITY_RETENTION_MS=600000
RUNTIME_ACTIVITY_CONSOLE=true

# Repository root exposed through scoped project tools.
# Empty defaults to the parent directory of Back/ when npm is run from Back/.
PROJECT_ROOT=
# Optional disposable scratch-file root. Empty defaults to the operating system temp directory.
OFFICE_WORKSPACE_ROOT=

# Model execution. Process concurrency, retries, thresholds, and task timeouts live in src/platform.config.mjs.
AI_REQUEST_TIMEOUT_MS=2700000
CHAT_AGENT_TIMEOUT_MS=2700000
NORA_INTAKE_TIMEOUT_MS=2700000
# Static defaults live in src/platform.config.mjs. Environment values are deployment overrides, not a second policy source.
PROCESS_NODE_TIMEOUT_MS=2700000

# Restart-safe operational state and durable worker leases (Node's built-in SQLite).
# Empty paths default to Back/.runtime/office-runtime.sqlite.
OFFICE_RUNTIME_DIR=
OFFICE_RUNTIME_DB_PATH=
JOB_QUEUE_LEASE_MS=120000
JOB_QUEUE_POLL_MS=1000
JOB_QUEUE_MAX_ATTEMPTS=5

# Verified successful workflows may be reviewed in a restricted background pass
# and distilled into auto-managed procedural skills. User-owned skills are never overwritten.
SKILL_EVOLUTION_ENABLED=true
SKILL_EVOLUTION_TIMEOUT_MS=300000

# Durable one-time, interval, and five-field cron schedules.
SCHEDULE_POLL_MS=15000

# Optional messaging gateways. Intake is fail-closed: configure an explicit comma-separated allowlist.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# WhatsApp Cloud API webhook/outbound configuration.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ALLOWED_NUMBERS=
EMAIL_WEBHOOK_URL=
EMAIL_INBOUND_SECRET=
EMAIL_ALLOWED_SENDERS=

# Optional outbound webhook adapters.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
OFFICE_WEBHOOK_URL=
# Signed generic inbound webhook at POST /api/channels/webhook.
OFFICE_WEBHOOK_SECRET=
OFFICE_WEBHOOK_ALLOWED_SOURCES=

# Semantic retrieval augments governed Markdown; Markdown remains authoritative.
# Only Shared, the current agent, and the active project's Knowledge folder are eligible.
MEMORY_SEMANTIC_ENABLED=true
MEMORY_EMBEDDING_MODEL=nomic-embed-text
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:11434
MEMORY_SEMANTIC_REFRESH_MS=300000
MEMORY_SEMANTIC_DOCUMENT_CHARS=12000
MEMORY_EMBEDDING_TIMEOUT_MS=30000

# Optional task-level routes. Blank model/provider values retain each agent's default.
# Classes: FAST, PLANNING, CODING, RESEARCH, QUALITY, SYNTHESIS, GENERAL.
MODEL_ROUTE_FAST_MODEL=
MODEL_ROUTE_PLANNING_MODEL=
MODEL_ROUTE_CODING_MODEL=
MODEL_ROUTE_RESEARCH_MODEL=
MODEL_ROUTE_QUALITY_MODEL=
MODEL_ROUTE_SYNTHESIS_MODEL=
MODEL_ROUTE_GENERAL_MODEL=

# Additional development boundaries. File deletion and dependency installation use
# the current authenticated request-authority capsule rather than persistent flags.
DEX_ALLOW_ARBITRARY_NPM_SCRIPTS=false
DEX_ALLOW_DEPLOY_COMMANDS=false

# Playwright browser inspection.
# Localhost and 127.0.0.1 are always allowed. Add exact additional origins only when required.
PLAYWRIGHT_ALLOWED_ORIGINS=

# Generic MCP integration gateway.
# Copy mcp.config.example.json to mcp.config.json to customize integrations.
MCP_CONFIG_PATH=
MCP_TOOL_CACHE_MS=60000
# Legacy deployment gates. Human action decisions are managed by the central allow/ask/deny
# authorization engine and its Authorizations UI; MCP role allowlists remain fail-closed.
MCP_ALLOW_DANGEROUS_ACTIONS=false

# Browser MCP. Install/connect the Browser MCP Chrome extension separately.
# Current Browser MCP normally connects through the extension; keep this field for extension builds that require a key.
BROWSER_MCP_EXTENSION_KEY=
BROWSER_MCP_ALLOW_INTERACTION=false

# Google Workspace MCP OAuth configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_EMAIL=

# Optional official GitHub MCP configuration. The example profile is disabled by default.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOOLSETS=context,repos,issues,pull_requests,actions

# Periodic connected-service monitors.
# Copy mcp.monitors.example.json to mcp.monitors.json to customize.
MCP_MONITORS_CONFIG_PATH=
MCP_MONITORS_ENABLED=true

# Ollama cloud primary with a local-only fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=minimax-m3:cloud
OLLAMA_FALLBACK_MODEL=qwen3:8b

# Permanent Markdown knowledge, automatically saved conversations, compact job receipts, remembered facts, and configuration.
OBSIDIAN_VAULT_PATH=
MEMORY_TIME_ZONE=America/Guayaquil

# Optional cloud providers
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional web-search providers. If none are configured, DuckDuckGo HTML is used.
SEARCH_PROVIDER=auto
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
