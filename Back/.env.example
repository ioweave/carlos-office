LOCAL_HOST=127.0.0.1
LOCAL_PORT=3002
# Permit any HTTP/HTTPS localhost or 127.0.0.1 frontend port while the backend is loopback-bound.
ALLOW_LOOPBACK_ORIGINS=true
# Explicit additional origins remain supported. Required when binding the backend beyond loopback.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Local API payload and attachment limits.
MAX_CHAT_BODY_BYTES=30000000
MAX_ATTACHMENT_BYTES=8388608
MAX_ATTACHMENTS_TOTAL_BYTES=20971520
MAX_TEXT_ATTACHMENT_CHARS=200000

# Retention lifecycle.
# Unsaved chats and session-only sources are volatile and expire from RAM automatically.
TEMP_CONVERSATION_TTL_MS=86400000
TEMP_SOURCE_TTL_MS=86400000
# Detailed job worker/Vera/Nora traces stay in RAM for recent inspection, then only the compact receipt remains.
JOB_TRACE_RETENTION_MS=86400000
JOB_RECEIPT_RESULT_CHARS=80000
# Remembered facts are compact semantic memory stored in one Markdown-backed record, not one file per fact.
MAX_REMEMBERED_FACTS=2000

# Repository root exposed through scoped project tools.
# Empty defaults to the parent directory of Back/ when npm is run from Back/.
PROJECT_ROOT=
# Optional working-file root. Empty defaults to <ObsidianVault>/60-Workspace.
OFFICE_WORKSPACE_ROOT=

# Model execution and bounded job scheduling.
AI_REQUEST_TIMEOUT_MS=120000
JOB_CONCURRENCY=2
JOB_DEFAULT_ITERATIONS=2
JOB_MAX_TOOL_ROUNDS=4
JOB_WORKER_TIMEOUT_MS=120000
JOB_QC_TOOL_ROUNDS=2
JOB_QC_TIMEOUT_MS=75000
JOB_NORA_REVIEW_TIMEOUT_MS=40000

# Dex source-change boundaries. Keep false until Carlos explicitly enables the capability.
DEX_ALLOW_PROJECT_DELETE=false
DEX_ALLOW_DEPENDENCY_INSTALL=false
DEX_ALLOW_ARBITRARY_NPM_SCRIPTS=false
DEX_ALLOW_DEPLOY_COMMANDS=false

# Playwright browser inspection.
# Localhost and 127.0.0.1 are always allowed. Add exact additional origins only when required.
PLAYWRIGHT_ALLOWED_ORIGINS=

# Generic MCP integration gateway.
# Copy mcp.config.example.json to mcp.config.json to customize integrations.
MCP_CONFIG_PATH=
MCP_TOOL_CACHE_MS=60000
# High-impact external actions (send/delete/share/deploy/etc.) stay blocked globally by default.
MCP_ALLOW_DANGEROUS_ACTIONS=false

# Browser MCP. Install/connect the Browser MCP Chrome extension separately.
# Current Browser MCP normally connects through the extension; keep this field for extension builds that require a key.
BROWSER_MCP_EXTENSION_KEY=
BROWSER_MCP_ALLOW_INTERACTION=false

# Google Workspace MCP OAuth configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_EMAIL=

# Optional official GitHub MCP configuration. The example profile is disabled by default.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_TOOLSETS=context,repos,issues,pull_requests,actions

# Periodic connected-service monitors.
# Copy mcp.monitors.example.json to mcp.monitors.json to customize.
MCP_MONITORS_CONFIG_PATH=
MCP_MONITORS_ENABLED=true

# Ollama cloud primary with a local-only fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=minimax-m3:cloud
OLLAMA_FALLBACK_MODEL=qwen3:8b

# Permanent Markdown knowledge, saved conversations, compact job receipts, remembered facts, and configuration.
OBSIDIAN_VAULT_PATH=
MEMORY_TIME_ZONE=America/Guayaquil

# Optional cloud providers
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional web-search providers. If none are configured, DuckDuckGo HTML is used.
SEARCH_PROVIDER=auto
SEARXNG_URL=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
