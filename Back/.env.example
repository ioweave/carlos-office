# Listen on all local interfaces so other devices on the LAN can reach the backend.
LOCAL_HOST=0.0.0.0
LOCAL_PORT=3002

# Canonical frontend origin. The backend also accepts loopback, .local, and
# private LAN browser origins (10/8, 172.16/12, 192.168/16, link-local, IPv6 ULA).
FRONTEND_ORIGIN=http://127.0.0.1:3003

# Provider endpoints and credentials are configured from the Providers/Credentials
# UI and stored locally under Back/.carlos-office/carlos-office.db.
# Existing OLLAMA_BASE_URL / OLLAMA_API_KEY values in an old .env are imported
# only when the local database is created for the first time.
